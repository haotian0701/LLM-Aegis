# Copy to .env and replace every secret before running. The app does not load .env automatically.
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis_dev_only@127.0.0.1:54329/aegis
AEGIS_API_KEYS_JSON={"demo-client":"replace-with-a-long-random-client-token"}
AEGIS_HMAC_KEY=replace-with-an-independent-long-random-hmac-key
AEGIS_RUN_MODE=demo
AEGIS_DEMO_PROVIDER=mock
AEGIS_MODEL_ALIASES_JSON={"aegis-mock":"mock-v1"}
