# Copy to .env and replace every secret before running. The app does not load .env automatically.
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis_dev_only@127.0.0.1:54329/aegis
AEGIS_API_KEYS_JSON={"demo-client":"replace-with-a-long-random-client-token"}
AEGIS_HMAC_KEY=replace-with-an-independent-long-random-hmac-key
AEGIS_RUN_MODE=demo
AEGIS_DEMO_PROVIDER=mock
# To call the configured cloud model for LOCAL decisions, use simulated_local instead of mock.
# This is external routing, not local inference; use synthetic data only.
# AEGIS_DEMO_PROVIDER=simulated_local
AEGIS_MODEL_ALIASES_JSON={"aegis-mock":"mock-v1"}
# Optional: use a validated YAML file instead of the bundled default policy.
# AEGIS_POLICY_PATH=D:\personal-project\Aegis\my-policy.yaml
# Demo-only external semantic classifier. Set all three together; use synthetic data only.
# AEGIS_SEMANTIC_URL=https://provider.example/v1/chat/completions
# AEGIS_SEMANTIC_API_KEY=replace-with-provider-key
# AEGIS_SEMANTIC_MODEL=replace-with-classifier-model
# Demo-only cloud model route. Both values are required together; use synthetic data only.
# AEGIS_CLOUD_BASE_URL=https://provider.example/v1
# AEGIS_CLOUD_API_KEY=replace-with-cloud-model-key
# Connected GitHub Issues workflow: set RUN_MODE=connected, omit DEMO_PROVIDER,
# and set every value below plus the semantic and cloud settings above.
# AEGIS_GITHUB_REPO=owner/dedicated-test-repo
# AEGIS_GITHUB_TOKEN=fine-grained-token-scoped-to-that-repo
# AEGIS_APPROVAL_KEY=stable-Fernet-key-generated-once
